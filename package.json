    "test:security": "tsx scripts/security-acceptance.ts",
    "test:automation": "tsx scripts/automation-acceptance.ts",
    "test:automation-performance": "tsx scripts/automation-performance.ts",
    "audit:production": "npm audit --omit=dev --omit=optional --omit=peer",
    "scan:secrets": "tsx scripts/secret-scan.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:phase4": "tsx scripts/seed-phase4-fixtures.ts",
    "test:performance": "tsx scripts/phase4-performance.ts",
    "test:postgis": "tsx scripts/verify-postgis-staging.ts",
    "test:restore": "tsx scripts/restore-acceptance.ts",
    "test:smoke": "tsx scripts/smoke-production.ts",
    "test:staging": "tsx scripts/smoke-staging.ts",
    "test:load": "tsx scripts/load-test.ts",
    "test:dependency-failure": "tsx scripts/dependency-failure-test.ts",
    "db:preflight": "tsx scripts/migration-preflight.ts",
    "db:backup": "tsx scripts/backup-database.ts",
    "db:housekeeping": "tsx scripts/housekeeping.ts",
    "jobs:run": "tsx scripts/run-automation-job.ts",
    "jobs:daily": "tsx scripts/run-daily-jobs.ts",
    "jobs:weekly": "tsx scripts/run-weekly-jobs.ts",
    "db:audit-integrity": "tsx scripts/audit-integrity.ts",
    "verify:ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run audit:production && npm run scan:secrets",
    "verify:release": "tsx scripts/release-acceptance.ts",
    "db:studio": "drizzle-kit studio",
    "admin:bootstrap": "node --conditions=react-server --import tsx scripts/bootstrap-admin.ts",
    "import:workbooks": "tsx scripts/import-workbooks.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "^9.1.2",
    "better-auth": "^1.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
