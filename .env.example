# Local database
DATABASE_URL=postgresql://postgres:change-this-local-password@localhost:5432/provider_tracker
DOCKER_DATABASE_URL=postgresql://postgres:change-this-local-password@postgres:5432/provider_tracker
POSTGRES_DB=provider_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-local-password
DATABASE_POOL_SIZE=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Workbook safety limits
WORKBOOK_MAX_FILE_BYTES=104857600
WORKBOOK_MAX_UNCOMPRESSED_BYTES=536870912
WORKBOOK_MAX_ROWS_PER_SHEET=100000
WORKBOOK_MAX_ZIP_ENTRIES=10000
WORKBOOK_MAX_COMPRESSION_RATIO=200
WORKBOOK_MAX_COLUMNS_PER_ROW=4096
WORKBOOK_MAX_CELL_CHARACTERS=32768
WORKBOOK_MAX_SHARED_STRINGS=250000

# Verification freshness (days)
VERIFICATION_ACCEPTING_FRESH_DAYS=30
VERIFICATION_ACCEPTING_STALE_DAYS=45
VERIFICATION_SCHEDULING_FRESH_DAYS=30
VERIFICATION_SCHEDULING_STALE_DAYS=45
VERIFICATION_SPECIALTY_FRESH_DAYS=180
VERIFICATION_SPECIALTY_STALE_DAYS=240
VERIFICATION_DIAGNOSIS_FRESH_DAYS=90
VERIFICATION_DIAGNOSIS_STALE_DAYS=120
VERIFICATION_CONTACT_FRESH_DAYS=180
VERIFICATION_CONTACT_STALE_DAYS=365

# App mode
APP_ENV=development
APP_DATA_MODE=database
# Production must use private-vpn. This is an application-side deployment assertion;
# IT must still verify private routing, VPN policy, DNS, and firewall rules in staging.
NETWORK_ACCESS_MODE=local
PROXY_TRUST_MODE=off
APP_MAINTENANCE_MODE=off
LOG_LEVEL=debug
# Use trusted-proxy only when the edge proxy replaces inbound X-Request-ID values.
REQUEST_ID_SOURCE=generate
GRACEFUL_SHUTDOWN_TIMEOUT_MS=20000
TZ=America/New_York

# Build/release identity. Deployment automation should set immutable values.
APP_VERSION=0.1.0
# APP_RELEASE=0.1.0-abc1234
# BUILD_COMMIT=abc1234
# BUILD_TIMESTAMP=2026-08-21T12:00:00Z

# Optional metrics endpoint. Omit to disable /api/metrics.
# OPERATIONS_TOKEN=use-a-random-value-with-at-least-32-characters

# Authentication and audit security
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-this-local-auth-secret-before-running
AUTH_TRUSTED_ORIGINS=http://localhost:3000
AUDIT_LOG_IP_SALT=change-this-local-audit-salt-before-running
# Eight-hour absolute lifetime, 30-minute idle timeout, 60-second activity touch,
# and a 15-minute recent-login window for sensitive administration.
AUTH_SESSION_ABSOLUTE_SECONDS=28800
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_TOUCH_SECONDS=60
PRIVILEGED_AUTH_MAX_AGE_SECONDS=900
# Set only when a trusted reverse proxy overwrites this header.
# AUTH_CLIENT_IP_HEADER=x-real-ip
# AUTH_TRUSTED_PROXY_CIDRS=10.20.0.0/16
