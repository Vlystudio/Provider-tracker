DJANGO_DEBUG=true
DEMO_MODE=true
DJANGO_SECRET_KEY=replace-me-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite
SQLITE_NAME=db.sqlite3
CELERY_TASK_ALWAYS_EAGER=true

# Production PostGIS/Redis configuration
POSTGRES_DB=provider_tracker
POSTGRES_USER=provider_tracker
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
CELERY_BROKER_URL=redis://redis:6379/0
SECURE_SSL_REDIRECT=true
