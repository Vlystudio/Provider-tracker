# This is a key list, not a deployable environment file. Values marked SET_BY_* must
# be supplied by the approved platform or secret store.

NODE_ENV=production
APP_ENV=production
APP_DATA_MODE=database
NETWORK_ACCESS_MODE=private-vpn
PROXY_TRUST_MODE=sanitized-ingress
REQUEST_ID_SOURCE=trusted-proxy
APP_MAINTENANCE_MODE=off
LOG_LEVEL=info
TZ=America/New_York

# Immutable release values from the release job
APP_VERSION=0.1.0
APP_RELEASE=SET_BY_RELEASE_JOB
BUILD_COMMIT=SET_BY_RELEASE_JOB_FULL_40_CHARACTER_COMMIT
BUILD_TIMESTAMP=SET_BY_RELEASE_JOB

# Application database; use the restricted runtime role and approved CA validation
DATABASE_URL=postgresql://provider_runtime:SET_BY_SECRET_MANAGER@db.internal.invalid:5432/provider_tracker?sslmode=verify-full
DATABASE_POOL_SIZE=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Private HTTPS origin and ingress trust
BETTER_AUTH_URL=https://provider-tracker.internal.invalid
AUTH_TRUSTED_ORIGINS=https://provider-tracker.internal.invalid
AUTH_CLIENT_IP_HEADER=x-real-ip
AUTH_TRUSTED_PROXY_CIDRS=SET_BY_NETWORK_TEAM

# Secret-store values; do not put real values in a file or image
BETTER_AUTH_SECRET=SET_BY_SECRET_MANAGER_MINIMUM_32_CHARACTERS
AUDIT_LOG_IP_SALT=SET_BY_SECRET_MANAGER_MINIMUM_32_CHARACTERS
OPERATIONS_TOKEN=SET_BY_SECRET_MANAGER_MINIMUM_32_CHARACTERS

# Approved session profile
AUTH_SESSION_ABSOLUTE_SECONDS=28800
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_TOUCH_SECONDS=60
PRIVILEGED_AUTH_MAX_AGE_SECONDS=900

# Runtime behavior
GRACEFUL_SHUTDOWN_TIMEOUT_MS=20000
GOVERNANCE_DORMANT_ACCOUNT_DAYS=SET_BY_APPROVED_ACCESS_POLICY
GOVERNANCE_INCIDENT_MAX_EVENTS=500
EXPORT_MAX_ROWS=SET_BY_APPROVED_EXPORT_POLICY
HOUSEKEEPING_BATCH_SIZE=1000
VERIFICATION_ACCEPTING_FRESH_DAYS=30
VERIFICATION_ACCEPTING_STALE_DAYS=45
VERIFICATION_SCHEDULING_FRESH_DAYS=30
VERIFICATION_SCHEDULING_STALE_DAYS=45
VERIFICATION_SPECIALTY_FRESH_DAYS=180
VERIFICATION_SPECIALTY_STALE_DAYS=240
VERIFICATION_DIAGNOSIS_FRESH_DAYS=90
VERIFICATION_DIAGNOSIS_STALE_DAYS=120
VERIFICATION_CONTACT_FRESH_DAYS=180
VERIFICATION_CONTACT_STALE_DAYS=365
