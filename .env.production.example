# Copy to .env.production on the deployment host. Never commit the populated file.
DJANGO_DEBUG=false
DEMO_MODE=false
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=provider-tracker.example.org
CSRF_TRUSTED_ORIGINS=https://provider-tracker.example.org

# Organization-managed PostgreSQL with the PostGIS extension available.
DB_ENGINE=postgis
POSTGRES_DB=provider_tracker
POSTGRES_USER=provider_tracker_app
POSTGRES_PASSWORD=replace-with-database-password
POSTGRES_HOST=database.internal.example.org
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60

# The application-only compose file supplies this Redis service.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# Enable when TLS terminates at a trusted reverse proxy that sets X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
APP_PORT=8000
WEB_CONCURRENCY=3
LOG_LEVEL=INFO
